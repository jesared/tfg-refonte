generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  role          Role           @default(USER)
  accounts      Account[]
  sessions      Session[]
  registrations Registration[]
}

model Player {
  id            String  @id @default(cuid())
  numeroLicence String  @unique
  nom           String
  prenom        String
  genre         Gender?
  club          String
  points        Int?

  registrations Registration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nom, prenom])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FacebookPost {
  id        String   @id
  message   String?
  image     String?
  permalink String
  createdAt DateTime
  syncedAt  DateTime @default(now())
  type      String?
}

model Tableau {
  id        Int      @id
  title     String
  points    String
  start     String
  updatedAt DateTime @updatedAt
}

model AgendaSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

model Registration {
  id String @id @default(cuid())

  status          RegistrationStatus @default(PENDING)
  licenceVerified Boolean            @default(false)
  paymentStatus   PaymentStatus      @default(UNPAID)
  checkInStatus   CheckInStatus      @default(NOT_CHECKED_IN)

  player   Player @relation(fields: [playerId], references: [id], onDelete: Restrict)
  playerId String

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  tournamentId String

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  engagements Engagement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([playerId, tournamentId])
  @@index([tournamentId, status])
  @@index([playerId, status])
}

model Engagement {
  id String @id @default(cuid())

  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationId String

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([registrationId, categoryId])
  @@index([categoryId])
  @@index([registrationId])
}

enum RegistrationStatus {
  PENDING
  VALIDATED
  REJECTED
  CANCELED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum CheckInStatus {
  NOT_CHECKED_IN
  CHECKED_IN
}

enum Gender {
  M
  F
}

model Tournament {
  id String @id @default(cuid())

  nom  String
  tour Int // ex: 1, 2, 3
  date DateTime

  // Club organisateur
  clubOrganisateur String

  // Salle (Google Maps ready)
  salleNom       String
  salleAdresse   String
  salleVille     String
  salleLatitude  Float?
  salleLongitude Float?
  sallePlaceId   String?

  inscriptionOuverte Boolean @default(false)

  categories    Category[]
  registrations Registration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model Category {
  id         String    @id @default(cuid())
  nom        String
  heureDebut DateTime
  heureFin   DateTime?
  minPoints  Int?
  maxPoints  Int?
  maxJoueurs Int?

  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  tournamentId String

  engagements Engagement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tournamentId])
  @@index([minPoints, maxPoints])
}
