generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  role          Role           @default(USER)
  accounts      Account[]
  sessions      Session[]
  registrations Registration[]

  communityProfile   CommunityProfile?
  communityPosts     CommunityPost[]
  communityComments  CommunityComment[]
  communityReactions CommunityReaction[]
  communityReports   CommunityReport[]
  mediaUploads       Media[]
}

enum StorageProvider {
  S3
  SUPABASE
}

model Media {
  id String @id @default(cuid())

  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  uploaderId String

  provider StorageProvider @default(SUPABASE)
  bucket   String
  objectKey String @unique

  thumbnailObjectKey String @unique

  originalUrl  String
  thumbnailUrl String
  name         String?
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?

  altText   String?
  sourceRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uploaderId, createdAt])
  @@index([createdAt])
}

model Player {
  id            String  @id @default(cuid())
  numeroLicence String  @unique
  nom           String
  prenom        String
  genre         Gender?
  club          String
  points        Int?

  registrations Registration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nom, prenom])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FacebookPost {
  id        String   @id
  message   String?
  image     String?
  permalink String
  createdAt DateTime
  syncedAt  DateTime @default(now())
  type      String?
}

model Tableau {
  id        Int      @id
  title     String
  points    String
  start     String
  updatedAt DateTime @updatedAt
}

model AgendaSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

model Registration {
  id String @id @default(cuid())

  status          RegistrationStatus @default(PENDING)
  licenceVerified Boolean            @default(false)
  paymentStatus   PaymentStatus      @default(UNPAID)
  checkInStatus   CheckInStatus      @default(NOT_CHECKED_IN)

  player   Player @relation(fields: [playerId], references: [id], onDelete: Restrict)
  playerId String

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  tournamentId String

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  engagements Engagement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([playerId, tournamentId])
  @@index([tournamentId, status])
  @@index([playerId, status])
}

model Engagement {
  id String @id @default(cuid())

  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationId String

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([registrationId, categoryId])
  @@index([categoryId])
  @@index([registrationId])
}

model CommunityProfile {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  displayName     String
  roleLabel       String?
  club            String?
  bio             String?
  classementLabel String?
  zone            CommunityZone?

  isVisible Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([club])
  @@index([zone])
}

model CommunityPost {
  id String @id @default(cuid())

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  tournamentId String?

  title    String?
  content  String
  imageUrl String?

  scope  CommunityPostScope  @default(TOURNAMENT)
  status CommunityPostStatus @default(PUBLISHED)
  zone   CommunityZone?

  comments  CommunityComment[]
  reactions CommunityReaction[]
  reports   CommunityReport[]

  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId, createdAt])
  @@index([tournamentId, createdAt])
  @@index([zone, createdAt])
  @@index([status, createdAt])
}

model CommunityComment {
  id String @id @default(cuid())

  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
}

model CommunityReaction {
  id String @id @default(cuid())

  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  type CommunityReactionType @default(LIKE)

  createdAt DateTime @default(now())

  @@unique([postId, authorId, type])
  @@index([postId])
  @@index([authorId])
}

model CommunityReport {
  id String @id @default(cuid())

  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String

  reporter   User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId String

  reason     CommunityReportReason
  details    String?
  status     CommunityReportStatus @default(OPEN)
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, status])
  @@index([reporterId, createdAt])
}

enum CommunityZone {
  MARNE
  ARDENNES
  BOTH
}

enum CommunityPostScope {
  TOURNAMENT
  CLUB
  GENERAL
}

enum CommunityPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  HIDDEN
}

enum CommunityReactionType {
  LIKE
  BRAVO
  FIRE
}

enum CommunityReportReason {
  SPAM
  HARASSMENT
  INSULT
  OFF_TOPIC
  OTHER
}

enum CommunityReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum RegistrationStatus {
  PENDING
  VALIDATED
  REJECTED
  CANCELED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum CheckInStatus {
  NOT_CHECKED_IN
  CHECKED_IN
}

enum Gender {
  M
  F
}

model Tournament {
  id String @id @default(cuid())

  nom  String
  tour Int // ex: 1, 2, 3
  date DateTime

  // Club organisateur
  clubOrganisateur String

  // Salle (Google Maps ready)
  salleNom       String
  salleAdresse   String
  salleVille     String
  salleLatitude  Float?
  salleLongitude Float?
  sallePlaceId   String?

  inscriptionOuverte Boolean @default(false)

  categories    Category[]
  registrations Registration[]

  communityPosts CommunityPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model Category {
  id         String    @id @default(cuid())
  nom        String
  heureDebut DateTime
  heureFin   DateTime?
  minPoints  Int?
  maxPoints  Int?
  maxJoueurs Int?

  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  tournamentId String

  engagements Engagement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tournamentId])
  @@index([minPoints, maxPoints])
}
