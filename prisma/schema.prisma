generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FacebookPost {
  id        String   @id
  message   String?
  image     String?
  permalink String
  createdAt DateTime
  syncedAt  DateTime @default(now())
  type      String?
}

model Tableau {
  id        Int      @id
  title     String
  points    String
  start     String
  updatedAt DateTime @updatedAt
}

model AgendaSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

model Registration {
  id String @id @default(cuid())

  nom           String
  prenom        String
  numeroLicence String
  genre         Gender?
  club          String
  points        Int?

  statut          RegistrationStatus @default(EN_ATTENTE)
  licenceVerified Boolean            @default(false)
  present         Boolean            @default(false)

  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  tournamentId String

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([numeroLicence, categoryId])
}

enum RegistrationStatus {
  EN_ATTENTE
  VALIDE
  REFUSE
  ANNULE
}

enum Gender {
  M
  F
}

model Tournament {
  id String @id @default(cuid())

  nom  String
  tour Int // ex: 1, 2, 3
  date DateTime

  // Club organisateur
  clubOrganisateur String

  // Salle (Google Maps ready)
  salleNom       String
  salleAdresse   String
  salleVille     String
  salleLatitude  Float?
  salleLongitude Float?
  sallePlaceId   String?

  inscriptionOuverte Boolean @default(false)

  categories    Category[]
  registrations Registration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id         String   @id @default(cuid())
  nom        String
  heureDebut DateTime
  heureFin   DateTime?
  minPoints  Int?
  maxPoints  Int?
  maxJoueurs Int?

  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  tournamentId String

  registrations Registration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
